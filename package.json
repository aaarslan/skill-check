{
  "name": "skill-check",
  "version": "1.1.0",
  "description": "Review skill files, compare revisions, and check local skill folders with deterministic analysis, portable reports, and a matching offline CLI.",
  "keywords": [
    "diff",
    "llm",
    "markdown",
    "prompt-injection",
    "quality",
    "react",
    "security"
  ],
  "homepage": "https://github.com/aaarslan/skill-check#readme",
  "bugs": {
    "url": "https://github.com/aaarslan/skill-check/issues"
  },
  "license": "MIT",
  "author": "Arslan Abdallah <arslan.abdallah@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaarslan/skill-check.git"
  },
  "bin": {
    "skillcheck": "dist-cli/skillcheck.mjs"
  },
  "files": [
    "dist-cli",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "test": "vp test && node --test scripts/skillcheck.test.mjs scripts/packaged-cli.test.mjs",
    "test:cli": "node --test scripts/skillcheck.test.mjs scripts/packaged-cli.test.mjs",
    "review": "node scripts/skillcheck.mjs",
    "calibrate": "node scripts/skillcheck.mjs --calibration",
    "prepare": "vp config && vp pack scripts/skillcheck.mjs --out-dir dist-cli --format esm --platform node",
    "coverage": "vp test --coverage",
    "test:e2e": "node --test scripts/e2e-smoke.test.mjs",
    "test:browser": "playwright test",
    "build:cli": "vp pack scripts/skillcheck.mjs --out-dir dist-cli --format esm --platform node",
    "prepack": "pnpm run build:cli"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}

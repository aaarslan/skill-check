{
  "name": "skill-check",
  "version": "0.0.1",
  "private": true,
  "description": "Review skill files, compare revisions, and check local skill folders with deterministic analysis, portable reports, and a matching offline CLI.",
  "keywords": [
    "diff",
    "llm",
    "markdown",
    "prompt-injection",
    "quality",
    "react",
    "security"
  ],
  "homepage": "https://github.com/aaarslan/skill-check#readme",
  "bugs": {
    "url": "https://github.com/aaarslan/skill-check/issues"
  },
  "license": "MIT",
  "author": "Arslan Abdallah <arslan.abdallah@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaarslan/skill-check.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "test": "vp test",
    "test:cli": "node --test scripts/skillcheck.test.mjs",
    "review": "node scripts/skillcheck.mjs",
    "calibrate": "node scripts/skillcheck.mjs --calibration",
    "prepare": "vp config"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "download"
    }
  }
}
